### Usage of module JSEventController

This module is meant to handle dom events dynamically, just by adding the data-js[event] attribute to any element

Let's suppose we have the following module

```javascript
defineModule("NotificationsMenu", ["CSSCore"], (function(global, requireModule, requireDynamic, requireLazy, module, exports, CSSCore) {
    'use strict';

    var notificationMenu = requireModule("$").fromIDOrElement("notifications_menu");

    function open() {
        CSSCore.show(notificationMenu);
    }

    exports.open = open;
}), null);
```

And also the following element

```html
<button type="button" data-jscontroller="NotificationsMenu" data-jsclick="@open">Open menu</button>
```

When the button gets a click the function 'open' inside the 'NotificationsMenu' gets called. All dom events are registered to handle the data-js[event] attribute.

#### Calling function with parameters

What if you want to pass arguments to a function, it is possible but they are passed as a string in a json format like the following example using the data-jsparams attribute:

```html
<button type="button" data-jscontroller="NotificationsMenu" data-jsclick="@open" data-jsparams="{'notifications_menu_id' : 'notifications_menu'}">Open menu</button>
```

```javascript
defineModule("NotificationsMenu", ["CSSCore"], (function(global, requireModule, requireDynamic, requireLazy, module, exports, CSSCore) {
    'use strict';

    function open(event, ctrlInstance) {
        var notificationMenu = requireModule("$").fromIDOrElement(ctrlInstance.getParam('notifications_menu_id'));
        CSSCore.show(notificationMenu);
    }

    exports.open = open;
}), null);
```
