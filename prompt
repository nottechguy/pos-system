        for (var i = 0; i < length; i++) {
            switch (deps[i]) {
                case "module":
                    dep = module;
                    break;
                case "exports":
                    dep = module.exports;
                    break;
                case "global":
                    dep = global;
                    break;
                case "requireModule":
                    dep = requireInterop;
                    break;
                case "requireDynamic":
                    dep = requireDynamic;
                    break;
                case "requireLazy":
                    dep = requireLazy;
                    break;
                case "importDefault":
                    dep = importDefault;
                    break;
                case "importNamespace":
                    dep = importNamespace;
                    break;
